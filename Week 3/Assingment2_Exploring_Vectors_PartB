#include <iostream> 
#include <vector>   //Again we need this to create our vector

using namespace std;

//Wehave our function that returns the average student id
double getAverage(const vector<int>& ids) {//we are passing by reference
    int sum = 0;
    for (int id : ids) {
        //range based for loop like the first scenario
        sum += id;
    }
    return (double)sum / ids.size(); 
    //we return average so we can continue and be able to use
}

//This is our second function
int getHighest(const vector<int>& ids) {//we used const vector <int>& again
    int highest = ids[0];
    //With this we check ids to see if we find highest ids
    for (int id : ids) {
        if (id > highest) {
            highest = id;
        }
    }
    
    // we do our loop again so we can get returned the highest
    return highest; 
}

int main() {
  //now we can create our vector
    vector<int> studentIDs;

//now we add our 10 student ids instead of cin
    studentIDs.push_back(74354154);
