    studentIDs.push_back(37840243);
    studentIDs.push_back(19398792);
    studentIDs.push_back(98326745);
    studentIDs.push_back(79359036);

    //we make surewe print them out
    cout << "Student IDs:\n";
    for (int i = 0; i < studentIDs.size(); i++) {
        cout << studentIDs[i] << " ";
    }
    cout << endl;

    //now with all the functions we will put them together to get our result
    double averageID = getAverage(studentIDs);
    int highestID = getHighest(studentIDs);

    cout << "Average Student ID: " << averageID << endl;
    cout << "Highest Student ID: " << highestID << endl;

    return 0;
}
